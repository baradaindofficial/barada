# ═══════════════════════════════════════════════════════════════════
# BARADA ACADEMY — Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env.local or .env to git
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────
# Get from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE   # Server only — never expose to client

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000              # Change to https://barada.in in production
NEXT_PUBLIC_APP_NAME=Barada Academy

# ── Google Analytics ─────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-313447218

# ── Microsoft Clarity ────────────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=xhif5v51ml

# ── Razorpay (payment) ────────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID      # Use rzp_live_ prefix in production
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET               # Server only

# ── Resend (email) ────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=academy@barada.in
RESEND_FROM_NAME=Barada Academy

# ── Certificate pricing ───────────────────────────────────────────
# In paise (₹299 = 29900 paise)
NEXT_PUBLIC_CERT_PRICE_PAISE=29900
NEXT_PUBLIC_CERT_PRICE_DISPLAY=₹299

# ── Next.js ────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
